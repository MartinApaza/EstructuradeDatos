//Pila.h//
#pragma once
#include <string>
#include <iostream>
#define MAX 100
using namespace std;
class Pila
{
private:
    string pila[MAX];
    int cima;

public:
    Pila();
    bool Apilar(const string& elemento);
    bool Desapilar();
    bool CimaPila(string& elemento);
    void LimpiarPila();
    void VerPila();
    bool PilaVacia();
    bool Iguales(Pila p);
};
//Pila.cpp//
#include "Pila.h"

Pila::Pila() {
    cima = -1;
}

bool Pila::Apilar(const string& elemento) {
    if (cima == MAX - 1) {
        cout << "Desbordamiento de Pila (Overflow)" << endl;
        return false;
    }
    cima++;
    pila[cima] = elemento;
    return true;
}

bool Pila::Desapilar() {
    if (cima == -1) {
        cerr << "Underflow: pila vacia" << endl;
        return false;
    }
    cima--;
    return true;
}

bool Pila::CimaPila(string& elemento) {
    if (PilaVacia()) {
        cerr << "Pila vacia" << endl;
        return false;
    }
    elemento = pila[cima];
    return true;
}

void Pila::VerPila() {
    for (int i = cima; i >= 0; i--) {
        cout << pila[i] << endl;
    }
}

bool Pila::PilaVacia() {
    return cima == -1;
}

void Pila::LimpiarPila() {
    cima = -1;
}

bool Pila::Iguales(Pila p) {
    if (cima != p.cima) return false;
    for (int i = 0; i <= cima; i++) {
        if (pila[i] != p.pila[i]) return false;
    }
    return true;
}
//Main//
#include <iostream>
#include <string>
#include "Pila.h"

using namespace std;

int main() {
    Pila p;
    string elemento;
    bool ok;

    cout << "Ingrese elementos para apilar ('fin' termina el programa): " << endl;

    while (true) {
        getline(cin, elemento);
        if (elemento == "fin") break;

        ok = p.Apilar(elemento);

        if (ok)
            cout << "Apilado correctamente" << endl;
        else
            cout << "Error: pila llena" << endl;
    }

    cout << "\nPila final:\n";
    p.VerPila();

    return 0;
}
